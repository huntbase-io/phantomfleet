# Copy to .env and fill in. Used by docker-compose.yml and
# docker-compose.examplecorp.yml. Placeholders only; never commit a real .env.

# ---- Target osquery TLS server ----
# Base URL of the TLS server. For osctrl this is the osctrl-tls service; the
# environment UUID below is appended to the path automatically.
PHANTOMFLEET_URL=https://osctrl.example.com/
# Server flavor: osctrl (per-environment paths) | generic (Fleet and other
# servers; use the --*-path flags to override endpoint paths if needed).
PHANTOMFLEET_FLAVOR=osctrl
# osctrl environment UUID. Leave empty for generic servers.
PHANTOMFLEET_ENV=00000000-0000-0000-0000-000000000000
# Enroll secret for that environment / server. REQUIRED. Passed to the
# container as the PHANTOMFLEET_SECRET environment variable, not as a flag.
PHANTOMFLEET_SECRET=replace-with-enroll-secret

# ---- Image ----
# Pin a release tag for reproducible runs, e.g. ghcr.io/huntbase-io/phantomfleet:v0.1.0
#PHANTOMFLEET_IMAGE=ghcr.io/huntbase-io/phantomfleet:latest

# ---- Simulation tuning ----
# Number of simulated hosts (ignored by the Example Corp variant, which pins 15).
PHANTOMFLEET_NODES=5
# Parallel enrollments at startup (raise for large fleets, e.g. 100 for 5000 hosts).
PHANTOMFLEET_ENROLL_CONCURRENCY=50
# Intervals in seconds.
PHANTOMFLEET_STATUS_INTERVAL=60
PHANTOMFLEET_RESULT_INTERVAL=60
PHANTOMFLEET_CONFIG_INTERVAL=45
PHANTOMFLEET_QUERY_INTERVAL=30

# Skip TLS certificate verification (self-signed test servers only).
PHANTOMFLEET_INSECURE=false
# Answer distributed queries with synthetic rows (no osqueryi required).
PHANTOMFLEET_FAKE_RESULTS=true
# Log how each fake-result query is decomposed (tables, seeding, row counts).
PHANTOMFLEET_EXPLAIN=false
# Output: quiet | summary | verbose | dashboard | json
PHANTOMFLEET_MODE=summary
TZ=UTC
